{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://code-review-harness/schemas/requirements-acceptance-response.schema.json","title":"External CAP-REQ Acceptance Response","type":"object","additionalProperties":false,
  "required":["response_id","packet_id","packet_hash","artifact_id","artifact_hash","decided_at","decided_by","disposition","rationale","authoritative_source_hash","decision_authority","effect","response_hash"],
  "properties":{"response_id":{"type":"string","format":"uuid"},"packet_id":{"type":"string","format":"uuid"},"packet_hash":{"$ref":"#/$defs/hash"},"artifact_id":{"type":"string","format":"uuid"},"artifact_hash":{"$ref":"#/$defs/hash"},"decided_at":{"type":"string","format":"date-time"},"decided_by":{"type":"object","additionalProperties":false,"required":["authority_role","authority_name"],"properties":{"authority_role":{"const":"requirements-acceptance-authority"},"authority_name":{"type":"string","minLength":1}}},"disposition":{"enum":["accept_review_as_complete","supply_authoritative_requirements","require_scope_correction","reject_artifact","insufficient_evidence"]},"rationale":{"type":"string","minLength":1},"authoritative_source_hash":{"$ref":"#/$defs/hash"},"decision_authority":{"const":"human"},"effect":{"const":"record_only"},"response_hash":{"$ref":"#/$defs/hash"}},
  "$defs":{"hash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}}
}
