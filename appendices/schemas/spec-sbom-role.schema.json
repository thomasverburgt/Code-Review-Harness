{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-review-harness/schemas/spec-sbom-role.schema.json",
  "title": "SPEC-SBOM Candidate Role Extension",
  "type": "object", "additionalProperties": false,
  "required": ["designation", "generation_method", "components", "changes", "coverage", "measures", "unknowns", "authority_boundary"],
  "properties": {
    "designation": {"const": "SPEC-SBOM"},
    "generation_method": {"type": "object", "additionalProperties": false, "required": ["method", "tool", "tool_version", "format", "generated_at", "source_population", "evidence_refs"], "properties": {
      "method": {"enum": ["declared_manifest_projection", "resolved_build_generation", "artifact_scan", "provided_sbom", "unknown"]}, "tool": {"type": ["string", "null"]}, "tool_version": {"type": ["string", "null"]}, "format": {"enum": ["cyclonedx", "spdx", "internal_projection", "none", "unknown"]}, "generated_at": {"type": ["string", "null"], "format": "date-time"}, "source_population": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
    }},
    "components": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["component_id", "component_name", "version", "purl_or_cpe", "supplier", "license", "component_criticality", "source_of_inventory", "build_system", "package_manager", "first_seen", "last_seen", "lineage", "inventory_completeness", "inventory_drift", "dependency_confidence", "evidence_refs"], "properties": {
      "component_id": {"type": "string", "minLength": 1}, "component_name": {"type": "string", "minLength": 1}, "version": {"type": ["string", "null"]}, "purl_or_cpe": {"type": ["string", "null"]}, "supplier": {"type": ["string", "null"]}, "license": {"type": ["string", "null"]},
      "component_criticality": {"enum": ["critical", "high", "moderate", "low", "not_assessed", "unknown"]}, "source_of_inventory": {"type": "string", "minLength": 1}, "build_system": {"type": ["string", "null"]}, "package_manager": {"type": ["string", "null"]}, "first_seen": {"type": ["string", "null"], "format": "date-time"}, "last_seen": {"type": ["string", "null"], "format": "date-time"},
      "lineage": {"enum": ["direct", "transitive", "vendored", "runtime_discovered", "unknown"]}, "inventory_completeness": {"enum": ["complete_for_declared_population", "partial", "unknown"]}, "inventory_drift": {"enum": ["none_observed", "observed", "not_comparable", "unknown"]}, "dependency_confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
    }}},
    "changes": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["change_id", "component_id", "change_type", "prior_version", "current_version", "evidence_refs"], "properties": {"change_id": {"type": "string", "minLength": 1}, "component_id": {"type": "string", "minLength": 1}, "change_type": {"enum": ["added", "removed", "upgraded", "downgraded", "unknown"]}, "prior_version": {"type": ["string", "null"]}, "current_version": {"type": ["string", "null"]}, "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}}},
    "coverage": {"type": "object", "additionalProperties": false, "required": ["declared_components", "identified_components", "resolved_components", "artifacts_scanned", "runtime_components_reviewed"], "properties": {"declared_components": {"type": "integer", "minimum": 0}, "identified_components": {"type": "integer", "minimum": 0}, "resolved_components": {"type": "integer", "minimum": 0}, "artifacts_scanned": {"type": "integer", "minimum": 0}, "runtime_components_reviewed": {"type": "integer", "minimum": 0}}},
    "measures": {"type": "object", "additionalProperties": false, "required": ["inventory_coverage", "identification_confidence", "sbom_completeness", "unexplained_drift_count", "critical_component_coverage"], "properties": {"inventory_coverage": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "identification_confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "sbom_completeness": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "unexplained_drift_count": {"type": ["integer", "null"], "minimum": 0}, "critical_component_coverage": {"type": ["number", "null"], "minimum": 0, "maximum": 1}}},
    "unknowns": {"type": "array", "items": {"$ref": "#/$defs/unknown"}},
    "authority_boundary": {"const": "inventory_evidence_only_no_vulnerability_release_or_governance_decision"}
  },
  "$defs": {"unknown": {"type": "object", "additionalProperties": false, "required": ["unknown_id", "statement", "missing_evidence", "evidence_refs"], "properties": {"unknown_id": {"type": "string", "minLength": 1}, "statement": {"type": "string", "minLength": 1}, "missing_evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}}}
}
