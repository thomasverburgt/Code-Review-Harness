{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-review-harness/schemas/enterprise-extension.schema.json",
  "title": "Enterprise Artifact Extension",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "enterprise_scope", "participating_capabilities", "capability_input_manifest",
    "cross_capability_correlations", "enterprise_assertions", "systemic_dependencies",
    "enterprise_unknowns", "unresolved_disagreements", "confidence_reconciliation",
    "human_decision_requests", "enterprise_traceability_manifest", "role"
  ],
  "properties": {
    "enterprise_scope": {"type": "object"},
    "participating_capabilities": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "capability_input_manifest": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "cross_capability_correlations": {"type": "array", "items": {"type": "object"}},
    "enterprise_assertions": {"type": "array", "items": {"type": "object"}},
    "systemic_dependencies": {"type": "array", "items": {"type": "object"}},
    "enterprise_unknowns": {"type": "array", "items": {"type": "object"}},
    "unresolved_disagreements": {"type": "array", "items": {"type": "object"}},
    "confidence_reconciliation": {"type": "object"},
    "human_decision_requests": {"type": "array", "items": {"type": "object"}},
    "enterprise_traceability_manifest": {"type": "object"},
    "role": {"type": "object", "minProperties": 1}
  }
}
