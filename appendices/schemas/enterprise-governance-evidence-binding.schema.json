{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://code-review-harness/schemas/enterprise-governance-evidence-binding.schema.json",
  "title": "ENT-GOV Exact Evidence Binding Manifest", "type": "object", "additionalProperties": false,
  "required": ["manifest_id", "manifest_version", "generated_at", "records", "manifest_hash"],
  "properties": {
    "manifest_id": {"type": "string", "format": "uuid"}, "manifest_version": {"const": "1.0.0"}, "generated_at": {"type": "string", "format": "date-time"},
    "records": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/record"}}, "manifest_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "record": {"type": "object", "additionalProperties": false,
      "required": ["locator_id", "source_kind", "source_id", "source_hash", "json_pointer", "expected_value", "purpose"],
      "properties": {"locator_id": {"type": "string", "minLength": 1}, "source_kind": {"enum": ["capability_artifact", "eligibility_record"]},
        "source_id": {"type": "string", "format": "uuid"}, "source_hash": {"$ref": "#/$defs/hash"}, "json_pointer": {"type": "string", "pattern": "^/"},
        "expected_value": {"type": ["string", "boolean", "number", "null"]}, "purpose": {"type": "string", "minLength": 1}}
    }
  }
}
