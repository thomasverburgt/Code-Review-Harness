{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-review-harness/schemas/spec-lint-role.schema.json",
  "title": "SPEC-LINT Candidate Role Extension",
  "type": "object", "additionalProperties": false,
  "required": ["designation", "rule_set", "executions", "violations", "suppressions", "quality_gate", "measures", "unknowns", "authority_boundary"],
  "properties": {
    "designation": {"const": "SPEC-LINT"},
    "rule_set": {"type": "object", "additionalProperties": false, "required": ["rule_set_id", "rule_version", "languages_or_frameworks", "configuration_refs", "evidence_refs"], "properties": {"rule_set_id": {"type": "string", "minLength": 1}, "rule_version": {"type": ["string", "null"]}, "languages_or_frameworks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "configuration_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}, "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}},
    "executions": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["execution_id", "tool", "tool_version", "source_population", "exit_code", "completed", "evidence_refs"], "properties": {"execution_id": {"type": "string", "minLength": 1}, "tool": {"type": "string", "minLength": 1}, "tool_version": {"type": ["string", "null"]}, "source_population": {"type": "array", "items": {"type": "string", "minLength": 1}}, "exit_code": {"type": ["integer", "null"]}, "completed": {"type": "boolean"}, "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}}},
    "violations": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["violation_id", "rule_id", "language_or_framework", "violation_class", "statement", "autofix_available", "suppression_reference", "suppression_rationale", "complexity_measure", "trend", "evidence_refs"], "properties": {"violation_id": {"type": "string", "minLength": 1}, "rule_id": {"type": "string", "minLength": 1}, "language_or_framework": {"type": "string", "minLength": 1}, "violation_class": {"enum": ["correctness", "maintainability", "complexity", "style", "documentation", "configuration", "unknown"]}, "statement": {"type": "string", "minLength": 1}, "autofix_available": {"type": ["boolean", "null"]}, "suppression_reference": {"type": ["string", "null"]}, "suppression_rationale": {"type": ["string", "null"]}, "complexity_measure": {"type": ["number", "null"], "minimum": 0}, "trend": {"enum": ["new", "persistent", "resolved", "not_comparable", "unknown"]}, "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}}},
    "suppressions": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["suppression_id", "rule_id", "reference", "rationale", "review_state", "evidence_refs"], "properties": {"suppression_id": {"type": "string", "minLength": 1}, "rule_id": {"type": "string", "minLength": 1}, "reference": {"type": "string", "minLength": 1}, "rationale": {"type": ["string", "null"]}, "review_state": {"enum": ["justified", "unjustified", "not_reviewed", "unknown"]}, "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}}},
    "quality_gate": {"type": "object", "additionalProperties": false, "required": ["defined", "threshold", "observed_result", "gate_state", "authority_effect"], "properties": {"defined": {"type": "boolean"}, "threshold": {"type": ["string", "null"]}, "observed_result": {"type": ["string", "null"]}, "gate_state": {"enum": ["passed", "failed", "not_executed", "not_defined", "unknown"]}, "authority_effect": {"const": "quality_signal_only"}}},
    "measures": {"type": "object", "additionalProperties": false, "required": ["eligible_files", "reviewed_files", "violation_count", "suppression_count", "autofixable_count", "complexity_trend"], "properties": {"eligible_files": {"type": "integer", "minimum": 0}, "reviewed_files": {"type": "integer", "minimum": 0}, "violation_count": {"type": "integer", "minimum": 0}, "suppression_count": {"type": "integer", "minimum": 0}, "autofixable_count": {"type": "integer", "minimum": 0}, "complexity_trend": {"enum": ["improving", "stable", "degrading", "not_measurable"]}}},
    "unknowns": {"type": "array", "items": {"$ref": "#/$defs/unknown"}},
    "authority_boundary": {"const": "defined_quality_rule_assessment_only_no_architecture_security_or_release_approval"}
  },
  "$defs": {"unknown": {"type": "object", "additionalProperties": false, "required": ["unknown_id", "statement", "missing_evidence", "evidence_refs"], "properties": {"unknown_id": {"type": "string", "minLength": 1}, "statement": {"type": "string", "minLength": 1}, "missing_evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}}}
}
