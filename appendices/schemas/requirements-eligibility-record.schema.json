{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://code-review-harness/schemas/requirements-eligibility-record.schema.json","title":"Derived CAP-REQ Eligibility Record","type":"object","additionalProperties":false,
  "required":["eligibility_id","artifact_id","artifact_hash","packet_id","packet_hash","response_id","response_hash","verification_id","verification_hash","derived_at","basis_disposition","state","rollback_state","reason","decision_authority","effect","cap_synth_scheduled","record_hash"],
  "properties":{"eligibility_id":{"type":"string","format":"uuid"},"artifact_id":{"type":"string","format":"uuid"},"artifact_hash":{"$ref":"#/$defs/hash"},"packet_id":{"type":"string","format":"uuid"},"packet_hash":{"$ref":"#/$defs/hash"},"response_id":{"type":"string","format":"uuid"},"response_hash":{"$ref":"#/$defs/hash"},"verification_id":{"type":"string","format":"uuid"},"verification_hash":{"$ref":"#/$defs/hash"},"derived_at":{"type":"string","format":"date-time"},"basis_disposition":{"enum":["accept_review_as_complete","supply_authoritative_requirements","require_scope_correction","reject_artifact","insufficient_evidence"]},"state":{"enum":["eligible_for_accepted_capability_input","not_eligible"]},"rollback_state":{"enum":["active","revoked"]},"reason":{"type":"string","minLength":1},"decision_authority":{"const":"derived_from_verified_human_record"},"effect":{"const":"eligibility_record_only"},"cap_synth_scheduled":{"const":false},"record_hash":{"$ref":"#/$defs/hash"}},
