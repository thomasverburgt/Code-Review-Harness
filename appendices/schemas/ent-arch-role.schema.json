    "shared_service_concentration":{"type":"array","items":{"$ref":"#/$defs/sourced"}},"failure_propagation":{"type":"array","items":{"$ref":"#/$defs/sourced"}},"target_state_alignment":{"type":"object"},"transition_architecture":{"type":"object"},"architecture_debt":{"type":"array","items":{"$ref":"#/$defs/sourced"}},"architecture_findings":{"type":"array","items":{"$ref":"#/$defs/sourced"}},"capa_options":{"type":"array","items":{"type":"object"}},"decision_requests":{"type":"array","items":{"type":"object"}},"unsupported_claims":{"type":"array","maxItems":0},
