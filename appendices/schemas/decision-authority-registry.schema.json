{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-review-harness/schemas/decision-authority-registry.schema.json",
  "title": "Report Governance Authority Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "registry_id", "registry_version", "authorities"],
  "properties": {
    "$schema": {"type": "string"},
    "registry_id": {"type": "string", "minLength": 1},
    "registry_version": {"type": "string", "minLength": 1},
    "authorities": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/authority"}}
  },
  "$defs": {
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority_role", "authority_kind", "human_subject_ids", "allowed_actions", "decision_types", "scope_ids", "assurance_levels"],
      "properties": {
        "authority_role": {"type": "string", "minLength": 1},
        "authority_kind": {"enum": ["distribution_authority", "expert_decision_authority", "records_administrator", "records_verifier"]},
        "human_subject_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "allowed_actions": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "decision_types": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "scope_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "assurance_levels": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
      }
    }
  }
}
