{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-review-harness/schemas/spec-iac-role.schema.json",
  "title": "SPEC-IAC Candidate Role Extension",
  "type": "object", "additionalProperties": false,
  "required": ["designation", "modules", "state_management", "coverage", "measures", "unknowns", "authority_boundary"],
  "properties": {
    "designation": {"const": "SPEC-IAC"},
    "modules": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false,
      "required": ["module_id", "module", "infrastructure_layer_owner", "module_maturity", "desired_state", "observed_state", "expected_state", "idempotency", "policy_inheritance", "dependency_order", "partial_deployment_failure_mode", "recovery_consideration", "change_blast_radius_prediction", "evidence_refs"],
      "properties": {
        "module_id": {"type": "string", "minLength": 1}, "module": {"type": "string", "minLength": 1}, "infrastructure_layer_owner": {"type": ["string", "null"]}, "module_maturity": {"enum": ["experimental", "supported", "blessed", "not_declared", "unknown"]},
        "desired_state": {"enum": ["declared", "partial", "not_observed", "unknown"]}, "observed_state": {"enum": ["matches_desired", "drift_observed", "not_observed", "unknown"]}, "expected_state": {"enum": ["declared", "partial", "not_declared", "unknown"]}, "idempotency": {"enum": ["demonstrated", "declared", "not_demonstrated", "not_assessed", "unknown"]}, "policy_inheritance": {"enum": ["explicit", "implicit", "not_observed", "not_assessed", "unknown"]}, "dependency_order": {"enum": ["explicit", "implicit", "not_observed", "not_assessed", "unknown"]}, "partial_deployment_failure_mode": {"enum": ["handled", "declared", "not_observed", "not_assessed", "unknown"]}, "recovery_consideration": {"enum": ["demonstrated", "declared", "not_observed", "not_assessed", "unknown"]}, "change_blast_radius_prediction": {"enum": ["bounded", "partially_bounded", "unbounded", "not_assessed", "unknown"]},
        "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }}},
    "state_management": {"type": "object", "additionalProperties": false, "required": ["backend", "locking", "encryption", "access_control", "evidence_refs"], "properties": {"backend": {"enum": ["remote", "local", "not_declared", "unknown"]}, "locking": {"enum": ["declared", "not_observed", "not_assessed", "unknown"]}, "encryption": {"enum": ["declared", "not_observed", "not_assessed", "unknown"]}, "access_control": {"enum": ["declared", "not_observed", "not_assessed", "unknown"]}, "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
    "coverage": {"type": "object", "additionalProperties": false, "required": ["iac_files_reviewed", "modules_reviewed", "plans_reviewed", "applies_reviewed", "drift_checks_reviewed", "rollback_tests_reviewed"], "properties": {"iac_files_reviewed": {"type": "integer", "minimum": 0}, "modules_reviewed": {"type": "integer", "minimum": 0}, "plans_reviewed": {"type": "integer", "minimum": 0}, "applies_reviewed": {"type": "integer", "minimum": 0}, "drift_checks_reviewed": {"type": "integer", "minimum": 0}, "rollback_tests_reviewed": {"type": "integer", "minimum": 0}}},
    "measures": {"type": "object", "additionalProperties": false, "required": ["managed_resource_coverage", "policy_conformance", "drift_detection_readiness", "idempotency_confidence", "partial_deployment_recovery_coverage", "ownership_clarity"], "properties": {"managed_resource_coverage": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "policy_conformance": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "drift_detection_readiness": {"enum": ["demonstrated", "declared", "not_demonstrated", "not_measurable"]}, "idempotency_confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "partial_deployment_recovery_coverage": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "ownership_clarity": {"type": ["number", "null"], "minimum": 0, "maximum": 1}}},
    "unknowns": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/unknown"}},
    "authority_boundary": {"const": "desired_state_assessment_only_no_runtime_health_deployment_or_product_approval"}
  },
  "$defs": {"unknown": {"type": "object", "additionalProperties": false, "required": ["unknown_id", "statement", "missing_evidence", "evidence_refs"], "properties": {"unknown_id": {"type": "string", "minLength": 1}, "statement": {"type": "string", "minLength": 1}, "missing_evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}}}
}
