{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-review-harness/schemas/distribution-approval-attestation.schema.json",
  "title": "External Distribution Approval Attestation",
  "type": "object",
  "additionalProperties": false,
  "required": ["distribution_approval_record_id", "report_package_id", "report_package_hash", "review_export_id", "approved_by", "approval_source", "recorded_by", "intended_recipients", "distribution_limitations", "approved_at", "recorded_at", "attestation_state", "effect"],
  "properties": {
    "distribution_approval_record_id": {"type": "string", "format": "uuid"},
    "report_package_id": {"type": "string", "format": "uuid"},
    "report_package_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "review_export_id": {"type": "string", "format": "uuid"},
    "approved_by": {"$ref": "#/$defs/externalAuthority"},
    "approval_source": {"$ref": "#/$defs/externalSource"},
    "recorded_by": {"$ref": "#/$defs/authenticatedActor"},
    "intended_recipients": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "distribution_limitations": {"type": "array", "items": {"type": "string"}},
    "approved_at": {"type": "string", "format": "date-time"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "attestation_state": {"enum": ["recorded_pending_verification", "recorded_pending_project_owner_finalization"]},
    "effect": {"const": "record_only"}
  },
  "$defs": {
    "externalAuthority": {
      "type": "object", "additionalProperties": false,
      "required": ["authority_role", "authority_name"],
      "properties": {"authority_role": {"type": "string", "minLength": 1}, "authority_name": {"type": "string", "minLength": 1}}
    },
    "externalSource": {
      "type": "object", "additionalProperties": false,
      "required": ["source_type", "source_reference", "source_hash"],
      "properties": {"source_type": {"type": "string", "minLength": 1}, "source_reference": {"type": "string", "minLength": 1}, "source_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
    },
    "authenticatedActor": {
      "type": "object", "additionalProperties": false,
      "required": ["actor_type", "subject_id", "authority_role", "authentication_provider", "assurance_level", "session_id"],
      "properties": {"actor_type": {"const": "human"}, "subject_id": {"type": "string", "minLength": 1}, "authority_role": {"type": "string", "minLength": 1}, "authentication_provider": {"type": "string", "minLength": 1}, "assurance_level": {"type": "string", "minLength": 1}, "session_id": {"type": "string", "minLength": 1}}
    }
  }
}
