{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://code-review-harness/schemas/enterprise-synthesis-semantic-review-packet.schema.json","title":"ENT-SYNTH Semantic Review Packet","type":"object","additionalProperties":false,"required":["packet_id","packet_version","generated_at","candidate","input_manifest","projection_provenance","review_dimensions","review_state","required_authority","effect","ent_synth_scheduled","report_effect","deployment_effect","packet_hash"],"properties":{"packet_id":{"type":"string","format":"uuid"},"packet_version":{"const":"1.0.0"},"generated_at":{"type":"string","format":"date-time"},"candidate":{"$ref":"#/$defs/ref"},"input_manifest":{"$ref":"#/$defs/ref"},"projection_provenance":{"type":"object"},"review_dimensions":{"type":"array","minItems":1,"items":{"type":"string"}},"review_state":{"const":"awaiting_human_semantic_review"},"required_authority":{"const":"project-owner"},"effect":{"const":"review_request_only"},"ent_synth_scheduled":{"const":false},"report_effect":{"const":"none"},"deployment_effect":{"const":"none"},"packet_hash":{"$ref":"#/$defs/hash"}},"$defs":{"hash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"ref":{"type":"object","additionalProperties":false,"required":["id","hash"],"properties":{"id":{"type":"string","format":"uuid"},"hash":{"$ref":"#/$defs/hash"}}}}}
