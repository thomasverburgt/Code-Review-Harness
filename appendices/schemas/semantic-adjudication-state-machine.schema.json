{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-review-harness/schemas/semantic-adjudication-state-machine.schema.json",
  "title": "Semantic Adjudication State Machine",
  "type": "object",
  "additionalProperties": false,
  "required": ["machine_id", "version", "initial_state", "terminal_states", "states", "transitions", "effects"],
  "properties": {
    "machine_id": {"const": "SEMANTIC-ADJUDICATION"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "initial_state": {"type": "string", "minLength": 1},
    "terminal_states": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "states": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string"}},
    "transitions": {
      "type": "array", "minItems": 1, "items": {
        "type": "object", "additionalProperties": false, "required": ["from", "event", "to", "actor_type", "guard"],
        "properties": {
          "from": {"type": "string"}, "event": {"type": "string"}, "to": {"type": "string"},
          "actor_type": {"enum": ["system", "external_authority", "records_administrator", "records_verifier"]},
          "guard": {"type": "string", "minLength": 1}
        }
      }
    },
    "effects": {
      "type": "object", "additionalProperties": false, "required": ["all_states", "cutover_authority", "required_follow_on"],
      "properties": {"all_states": {"const": "record_only"}, "cutover_authority": {"const": "none"}, "required_follow_on": {"const": "separate project-maintainer ADR"}}
    }
  }
}
