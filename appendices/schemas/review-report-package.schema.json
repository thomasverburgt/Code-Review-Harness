{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-review-harness/schemas/review-report-package.schema.json",
  "title": "Immutable Review Report Package",
  "type": "object",
  "additionalProperties": false,
  "required": ["report_package_id", "report_version", "workflow_id", "enterprise_scope_id", "generated_at", "source_artifacts", "source_contexts", "report_items", "evidence_items", "evidence_refs", "confidence", "coverage", "conflicts", "uncertainties", "technical_state", "package_hash"],
  "properties": {
    "report_package_id": {"type": "string", "format": "uuid"},
    "report_version": {"type": "string"},
    "workflow_id": {"type": "string"},
    "enterprise_scope_id": {"type": "string"},
    "generated_at": {"type": "string", "format": "date-time"},
    "source_artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceArtifact"}},
    "source_contexts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceContext"}},
    "report_items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/reportItem"}},
    "evidence_items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidenceItem"}},
    "evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "confidence": {"type": "object"},
    "coverage": {"type": "object"},
    "conflicts": {"type": "array", "items": {"type": "object"}},
    "uncertainties": {"type": "array", "items": {"type": "string"}},
    "technical_state": {"const": "technically_validated"},
    "package_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "$defs": {
    "sourceArtifact": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_id", "output_hash", "designation", "artifact_type"],
      "properties": {"artifact_id": {"type": "string", "format": "uuid"}, "output_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "designation": {"type": "string", "minLength": 1}, "artifact_type": {"type": "string", "minLength": 1}}
    },
    "sourceContext": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_id", "confidence", "coverage", "conflicts", "methodology"],
      "properties": {"artifact_id": {"type": "string", "format": "uuid"}, "confidence": {"type": "object"}, "coverage": {"type": "object"}, "conflicts": {"type": "array"}, "methodology": {"type": "object"}}
    },
    "reportItem": {
      "type": "object", "additionalProperties": false,
      "required": ["report_item_id", "kind", "source_artifact_id", "source_record_id", "statement", "evidence_refs", "details", "advisory"],
      "properties": {"report_item_id": {"type": "string", "minLength": 1}, "kind": {"enum": ["finding", "risk", "capa", "recommendation"]}, "source_artifact_id": {"type": "string", "format": "uuid"}, "source_record_id": {"type": "string", "minLength": 1}, "statement": {"type": "string", "minLength": 1}, "evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "details": {"type": "object"}, "advisory": {"const": true}}
    },
    "evidenceItem": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_item_id", "source_artifact_id", "source_record_id", "statement", "evidence_refs"],
      "properties": {"evidence_item_id": {"type": "string", "minLength": 1}, "source_artifact_id": {"type": "string", "format": "uuid"}, "source_record_id": {"type": "string", "minLength": 1}, "statement": {"type": "string", "minLength": 1}, "evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}}
    }
  }
}
