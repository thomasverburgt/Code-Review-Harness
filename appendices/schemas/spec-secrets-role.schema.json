{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-review-harness/schemas/spec-secrets-role.schema.json",
  "title": "SPEC-SECRETS Role Extension",
  "type": "object",
  "additionalProperties": false,
  "required": ["designation", "secret_observations", "measures"],
  "properties": {
    "designation": {"const": "SPEC-SECRETS"},
    "secret_observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["observation_id", "secret_type", "evidence_state", "exposure_location", "owner_role", "rotation_policy", "age_or_expiry", "approved_storage_reference", "blast_radius", "regulatory_or_policy_impact", "evidence_refs"],
        "properties": {
          "observation_id": {"type": "string", "minLength": 1},
          "secret_type": {"type": "string", "minLength": 1},
          "evidence_state": {"enum": ["confirmed_secret", "likely_secret", "unresolved_credential_like_value"]},
          "exposure_location": {"type": "string", "minLength": 1},
          "owner_role": {"type": ["string", "null"]},
          "rotation_policy": {"type": ["string", "null"]},
          "age_or_expiry": {"type": ["string", "null"]},
          "approved_storage_reference": {"type": ["string", "null"]},
          "blast_radius": {"type": "object"},
          "regulatory_or_policy_impact": {"type": "array", "items": {"type": "string"}},
          "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "exposure_root_cause": {"type": ["string", "null"]}
        }
      }
    },
    "measures": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eligible_coverage", "confirmed_exposure_count", "managed_secret_adoption", "rotation_compliance", "unresolved_detection_rate"],
      "properties": {
        "eligible_coverage": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "confirmed_exposure_count": {"type": "integer", "minimum": 0},
        "managed_secret_adoption": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "rotation_compliance": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "unresolved_detection_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      }
    }
  }
}
