{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-review-harness/schemas/specialist-shadow-review-response.schema.json",
  "title": "Non-Authoritative Specialist Human Shadow Review Response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "response_id", "response_version", "packet_id", "packet_hash", "reviewer", "started_at",
    "completed_at", "item_reviews", "overall_usability", "evidence_requests", "classification",
    "non_authoritative_acknowledged", "decision_authority", "authority_effect", "response_hash"
  ],
  "properties": {
    "response_id": {"type": "string", "format": "uuid"},
    "response_version": {"const": "1.0.0"},
    "packet_id": {"type": "string", "format": "uuid"},
    "packet_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_id", "reviewer_track", "experience_level", "domain_qualifications", "authorized_classifications", "conflict_of_interest"],
      "properties": {
        "reviewer_id": {"type": "string", "minLength": 1},
        "reviewer_track": {"enum": ["general_engineering_intern", "restricted_domain_reviewer", "qualified_subject_matter_expert"]},
        "experience_level": {"enum": ["intern", "junior", "mid", "senior", "subject_matter_expert"]},
        "domain_qualifications": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "authorized_classifications": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["public", "internal", "restricted"]}},
        "conflict_of_interest": {"type": ["string", "null"]}
      }
    },
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "item_reviews": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_id", "disposition", "rationale", "locator_correctness", "severity_reasonableness",
          "recommendation_reasonableness", "missing_evidence"
        ],
        "properties": {
          "item_id": {"type": "string", "minLength": 1},
          "disposition": {"enum": ["supported", "partially_supported", "unsupported", "duplicate", "outside_specialist_scope", "unable_to_determine"]},
          "rationale": {"type": "string", "minLength": 1},
          "locator_correctness": {"enum": ["correct", "partially_correct", "incorrect", "not_verified"]},
          "severity_reasonableness": {"enum": ["reasonable", "too_high", "too_low", "not_applicable", "unable_to_determine"]},
          "recommendation_reasonableness": {"enum": ["reasonable", "partially_reasonable", "unreasonable", "not_applicable", "unable_to_determine"]},
          "missing_evidence": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "overall_usability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rating", "rationale", "would_request_more_evidence"],
      "properties": {
        "rating": {"type": "integer", "minimum": 1, "maximum": 5},
        "rationale": {"type": "string", "minLength": 1},
        "would_request_more_evidence": {"type": "boolean"}
      }
    },
    "evidence_requests": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "classification": {"const": "non_authoritative_human_review"},
    "non_authoritative_acknowledged": {"const": true},
    "decision_authority": {"const": "human"},
    "authority_effect": {"const": "calibration_evidence_only"},
    "response_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
