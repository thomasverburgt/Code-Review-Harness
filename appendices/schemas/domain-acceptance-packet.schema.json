{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://code-review-harness/schemas/domain-acceptance-packet.schema.json","title":"Enterprise Domain Acceptance Packet","type":"object","additionalProperties":false,"required":["packet_id","packet_version","generated_at","readiness_manifest_id","readiness_manifest_hash","prerequisite_id","designation","required_authority","current_evidence","review_state","missing_requirements","accepted_response_allowed","decision_authority","effect","packet_hash"],"properties":{"packet_id":{"type":"string","format":"uuid"},"packet_version":{"const":"1.0.0"},"generated_at":{"type":"string","format":"date-time"},"readiness_manifest_id":{"type":"string","format":"uuid"},"readiness_manifest_hash":{"$ref":"#/$defs/hash"},"prerequisite_id":{"type":"string"},"designation":{"enum":["ENT-ARCH","ENT-GOV","ENT-STRAT","ENT-SYNTH"]},"required_authority":{"type":"string"},"current_evidence":{"type":"object","additionalProperties":false,"required":["path","content_hash","evidence_tier"],"properties":{"path":{"type":"string"},"content_hash":{"$ref":"#/$defs/hash"},"evidence_tier":{"const":"protocol_smoke_only"}}},"review_state":{"const":"not_ready_for_review"},"missing_requirements":{"type":"array","minItems":1,"items":{"type":"string"}},"accepted_response_allowed":{"const":false},"decision_authority":{"const":"human"},"effect":{"const":"evidence_gap_notice_only"},"packet_hash":{"$ref":"#/$defs/hash"}},"$defs":{"hash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}}}
