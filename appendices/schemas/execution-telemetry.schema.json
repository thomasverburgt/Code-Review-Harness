{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-review-harness/schemas/execution-telemetry.schema.json",
  "title": "Worker Execution Telemetry",
  "type": "object",
  "additionalProperties": false,
  "required": ["telemetry_id", "job_id", "execution_id", "dispatch_id", "node_id", "designation", "worker_id", "model_provider", "model_id", "prompt_version", "prompt_sha256", "rubric_version", "toolchain_version", "generation_mode", "generation_contract_version", "generation_contract_sha256", "assembler_version", "attempts", "wall_duration_ms", "cpu_duration_ms", "input_tokens", "output_tokens", "cost_usd", "status"],
  "properties": {
    "telemetry_id": {"type": "string", "format": "uuid"},
    "job_id": {"type": "string", "format": "uuid"},
    "execution_id": {"type": "string", "format": "uuid"},
    "dispatch_id": {"type": "string", "format": "uuid"},
    "node_id": {"type": "string"},
    "designation": {"type": "string"},
    "worker_id": {"type": "string"},
    "model_provider": {"type": "string"},
    "model_id": {"type": "string"},
    "prompt_version": {"type": "string"},
    "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rubric_version": {"type": "string"},
    "toolchain_version": {"type": "string"},
    "generation_mode": {"enum": ["full_artifact", "role_payload_v1", "canonical_payload_v1"]},
    "generation_contract_version": {"type": "string", "minLength": 1},
    "generation_contract_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "assembler_version": {"type": "string", "minLength": 1},
    "projection_version": {"type": "string", "minLength": 1},
    "projection_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "attempts": {"type": "array", "items": {"type": "object"}},
    "wall_duration_ms": {"type": "integer", "minimum": 0},
    "cpu_duration_ms": {"type": "integer", "minimum": 0},
    "input_tokens": {"type": "integer", "minimum": 0},
    "output_tokens": {"type": "integer", "minimum": 0},
    "cost_usd": {"type": "number", "minimum": 0},
    "status": {"enum": ["complete", "failed", "cancelled"]}
  }
}
