{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-review-harness/schemas/evidence-binding-manifest.schema.json",
  "title": "Report Item Evidence Binding Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_id", "report_package_id", "report_package_hash", "bindings", "manifest_hash"],
  "properties": {
    "manifest_id": {"type": "string", "format": "uuid"},
    "report_package_id": {"type": "string", "format": "uuid"},
    "report_package_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "bindings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/binding"}},
    "manifest_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "$defs": {
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["report_item_id", "evidence_refs", "binding_basis"],
      "properties": {"report_item_id": {"type": "string", "minLength": 1}, "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "binding_basis": {"enum": ["direct_report_reference", "explicit_derived_item_binding"]}}
    }
  }
}
