{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://code-review-harness/schemas/cap-req-role.schema.json","title":"CAP-REQ Role Extension","type":"object","additionalProperties":false,
  "required":["designation","evidence_tier","declared_population","requirement_records","traceability_gaps","coverage","unsupported_claims","acceptance_state","decision_requests","decision_authority"],
  "properties":{
    "designation":{"const":"CAP-REQ"},"evidence_tier":{"const":"accepted_live_input_calibration"},
    "declared_population":{"type":"object","additionalProperties":false,"required":["source_manifest_hash","count","population_state"],"properties":{"source_manifest_hash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"count":{"type":"integer","minimum":0},"population_state":{"enum":["declared","none_declared_for_slice"]}}},
    "requirement_records":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["requirement_id","source_locator","text_hash","satisfaction_state","evidence_refs","rationale","confidence"],"properties":{"requirement_id":{"type":"string"},"source_locator":{"type":"string"},"text_hash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"satisfaction_state":{"enum":["satisfied","partially_satisfied","unsatisfied","unknown","not_reviewed"]},"evidence_refs":{"type":"array","items":{"type":"string"}},"rationale":{"type":"string"},"confidence":{"type":["number","null"],"minimum":0,"maximum":1}}}},
    "traceability_gaps":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["gap_id","statement","evidence_locator_ids","state"],"properties":{"gap_id":{"type":"string"},"statement":{"type":"string"},"evidence_locator_ids":{"type":"array","items":{"type":"string"}},"state":{"enum":["unresolvable_without_declared_requirement","missing_evidence","ambiguous_mapping"]}}}},
    "coverage":{"type":"object","additionalProperties":false,"required":["declared","reviewed","satisfied","partially_satisfied","unsatisfied","unknown","not_reviewed","fraction"],"properties":{"declared":{"type":"integer","minimum":0},"reviewed":{"type":"integer","minimum":0},"satisfied":{"type":"integer","minimum":0},"partially_satisfied":{"type":"integer","minimum":0},"unsatisfied":{"type":"integer","minimum":0},"unknown":{"type":"integer","minimum":0},"not_reviewed":{"type":"integer","minimum":0},"fraction":{"type":["number","null"],"minimum":0,"maximum":1}}},
    "unsupported_claims":{"type":"array","items":{"type":"object"}},"acceptance_state":{"const":"pending_human_requirements_acceptance"},
    "decision_requests":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["decision_context_id","question","required_authority"],"properties":{"decision_context_id":{"type":"string"},"question":{"type":"string"},"required_authority":{"const":"requirements-acceptance-authority"}}}},"decision_authority":{"const":"human"}
  }
}
