{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-review-harness/schemas/ent-sysrisk-role.schema.json",
  "title": "ENT-SYSRISK Role Extension",
  "type": "object",
  "additionalProperties": false,
  "required": ["designation", "systemic_risk_register", "risk_propagation_analysis", "concentration_analysis", "risk_relationship_graph", "escalation_flags", "advisory_treatment_options", "enterprise_risk_capas", "decision_authority"],
  "properties": {
    "designation": {"const": "ENT-SYSRISK"},
    "systemic_risk_register": {"type": "array", "items": {"$ref": "#/$defs/risk"}},
    "risk_propagation_analysis": {"type": "array", "items": {"type": "object"}},
    "concentration_analysis": {"type": "array", "items": {"type": "object"}},
    "risk_relationship_graph": {"type": "array", "items": {"$ref": "#/$defs/relationship"}},
    "escalation_flags": {"type": "array", "items": {"type": "object"}},
    "advisory_treatment_options": {"type": "array", "items": {"type": "object"}},
    "enterprise_risk_capas": {"type": "array", "items": {"type": "object"}},
    "decision_authority": {"const": "human"}
  },
  "$defs": {
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enterprise_risk_id", "risk_statement", "risk_category", "risk_origin", "contributing_capabilities", "contributing_risk_ids", "dependency_chain", "affected_enterprise_objectives", "affected_mission_threads", "probability", "probability_basis", "consequence", "consequence_basis", "priority", "scoring_method", "rubric_version", "evidence_refs", "confidence_provenance", "unknowns", "escalation_state", "decision_authority"],
      "properties": {
        "enterprise_risk_id": {"type": "string", "minLength": 1},
        "risk_statement": {"type": "string", "minLength": 1},
        "risk_category": {"type": "string", "minLength": 1},
        "risk_origin": {"enum": ["inherited", "derived", "systemic_emergent"]},
        "contributing_capabilities": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "contributing_risk_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "dependency_chain": {"type": "array", "items": {"type": "string"}},
        "affected_enterprise_objectives": {"type": "array", "items": {"type": "string"}},
        "affected_mission_threads": {"type": "array", "items": {"type": "string"}},
        "probability": {"type": ["number", "string", "null"]},
        "probability_basis": {"type": "string", "minLength": 1},
        "consequence": {"type": ["number", "string", "null"]},
        "consequence_basis": {"type": "string", "minLength": 1},
        "priority": {"type": ["number", "string", "null"]},
        "scoring_method": {"type": "string", "minLength": 1},
        "rubric_version": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "confidence_provenance": {"type": "array", "items": {"type": "object"}},
        "unknowns": {"type": "array", "items": {"type": "string"}},
        "escalation_state": {"type": "string", "minLength": 1},
        "decision_authority": {"const": "human"}
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "relationship", "target_id", "evidence_refs", "confidence"],
      "properties": {
        "source_id": {"type": "string"},
        "relationship": {"enum": ["contributes_to", "correlates_with", "amplifies", "depends_on", "cascades_to", "shares_common_cause_with", "conflicts_with", "supersedes", "derived_from"]},
        "target_id": {"type": "string"},
        "evidence_refs": {"type": "array", "items": {"type": "string"}},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      }
    }
  }
}
