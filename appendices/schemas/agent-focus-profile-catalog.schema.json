{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-review-harness/schemas/agent-focus-profile-catalog.schema.json",
  "title": "Agent Focus Profile Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_version", "generated_from", "profiles"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "catalog_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "generated_from": {
      "type": "array",
      "const": ["agents/agent-identities.json", "agents/focus-profiles"]
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["agent_uuid", "designation", "layer", "profile_id", "profile_version", "path", "sha256"],
        "properties": {
          "agent_uuid": {"type": "string", "format": "uuid"},
          "designation": {"type": "string"},
          "layer": {"enum": ["specialist", "product", "capability", "enterprise", "work", "orchestration"]},
          "profile_id": {"type": "string"},
          "profile_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "path": {"type": "string", "pattern": "^agents/focus-profiles/[a-z0-9-]+\\.json$"},
          "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    }
  }
}
