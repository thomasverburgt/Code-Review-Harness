{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-review-harness/schemas/requirements-acceptance-packet.schema.json",
  "title": "CAP-REQ Human Acceptance Review Packet",
  "type": "object", "additionalProperties": false,
  "required": ["packet_id","packet_version","generated_at","cap_req_artifact","source_manifest","evidence_locator","execution_pins","review_facts","available_dispositions","required_authority","decision_authority","effect","eligibility_state","isolation","packet_hash"],
  "properties": {
    "packet_id": {"type":"string","format":"uuid"}, "packet_version":{"const":"1.0.0"}, "generated_at":{"type":"string","format":"date-time"},
    "cap_req_artifact":{"type":"object","additionalProperties":false,"required":["artifact_id","output_hash","content_hash","lifecycle_state","acceptance_state"],"properties":{"artifact_id":{"type":"string","format":"uuid"},"output_hash":{"$ref":"#/$defs/hash"},"content_hash":{"$ref":"#/$defs/hash"},"lifecycle_state":{"const":"complete"},"acceptance_state":{"const":"pending_human_requirements_acceptance"}}},
    "source_manifest":{"type":"object","additionalProperties":false,"required":["content_hash","scope_id","immutable_revision","declared_requirement_count","interpretation_boundary"],"properties":{"content_hash":{"$ref":"#/$defs/hash"},"scope_id":{"type":"string","minLength":1},"immutable_revision":{"type":"string","minLength":1},"declared_requirement_count":{"const":0},"interpretation_boundary":{"type":"string","minLength":1}}},
    "evidence_locator":{"type":"object","additionalProperties":false,"required":["locator_id","locator_hash","repository_uri","immutable_revision","path","line_start","line_end","line_fingerprint"],"properties":{"locator_id":{"type":"string","minLength":1},"locator_hash":{"$ref":"#/$defs/hash"},"repository_uri":{"type":"string","minLength":1},"immutable_revision":{"type":"string","minLength":1},"path":{"type":"string","minLength":1},"line_start":{"type":"integer","minimum":1},"line_end":{"type":"integer","minimum":1},"line_fingerprint":{"$ref":"#/$defs/hash"}}},
    "execution_pins":{"type":"object","additionalProperties":false,"required":["model","prompt_version","rubric_version","projection_version","toolchain_version"],"properties":{"model":{"type":"string","minLength":1},"prompt_version":{"type":"string","minLength":1},"rubric_version":{"type":"string","minLength":1},"projection_version":{"type":"string","minLength":1},"toolchain_version":{"type":"string","minLength":1}}},
    "review_facts":{"type":"object","additionalProperties":false,"required":["requirement_records","satisfaction_claim_present","satisfaction_rate","traceability_gap_ids","human_decision_request_ids","interpretation"],"properties":{"requirement_records":{"const":0},"satisfaction_claim_present":{"const":false},"satisfaction_rate":{"type":"null"},"traceability_gap_ids":{"type":"array","const":["GAP-REQ-001"]},"human_decision_request_ids":{"type":"array","const":["DC-REQ-001"]},"interpretation":{"const":"zero_declared_requirements_is_unassessable_not_satisfied"}}},
    "available_dispositions":{"type":"array","const":["accept_review_as_complete","supply_authoritative_requirements","require_scope_correction","reject_artifact","insufficient_evidence"]},
    "required_authority":{"const":"requirements-acceptance-authority"}, "decision_authority":{"const":"human"}, "effect":{"const":"review_request_only"}, "eligibility_state":{"const":"blocked_pending_human_requirements_acceptance"},
    "isolation":{"type":"object","additionalProperties":false,"required":["baseline_workflow_changed","report_package_changed","cap_synth_scheduled","deployment_effect"],"properties":{"baseline_workflow_changed":{"const":false},"report_package_changed":{"const":false},"cap_synth_scheduled":{"const":false},"deployment_effect":{"const":"none"}}},
    "packet_hash":{"$ref":"#/$defs/hash"}
  }, "$defs":{"hash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}}
}
