{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-review-harness/schemas/prod-synth-role.schema.json",
  "title": "PROD-SYNTH Role Extension",
  "type": "object",
  "additionalProperties": false,
  "required": ["designation", "synthesis_basis", "preserved_child_assertions", "derived_product_assertions", "engineering_posture", "confidence_reconciliation", "capability_handoff", "decision_authority"],
  "properties": {
    "designation": {"const": "PROD-SYNTH"},
    "synthesis_basis": {
      "type": "object", "additionalProperties": false,
      "required": ["required_designations", "received_artifact_ids", "completeness_state", "partial_input_authorization"],
      "properties": {
        "required_designations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "received_artifact_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "format": "uuid"}},
        "completeness_state": {"enum": ["complete", "authorized_partial", "blocked"]},
        "partial_input_authorization": {"type": ["object", "null"]}
      }
    },
    "preserved_child_assertions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/preservedAssertion"}},
    "derived_product_assertions": {"type": "array", "items": {"$ref": "#/$defs/derivedAssertion"}},
    "engineering_posture": {"type": "object", "additionalProperties": false, "required": ["state", "rationale", "limitations", "advisory_only"], "properties": {"state": {"type": "string", "minLength": 1}, "rationale": {"type": "string", "minLength": 1}, "limitations": {"type": "array", "items": {"type": "string"}}, "advisory_only": {"const": true}}},
    "confidence_reconciliation": {"type": "object", "additionalProperties": false, "required": ["method", "input_values", "result", "uncertainty"], "properties": {"method": {"type": "string", "minLength": 1}, "input_values": {"type": "array", "minItems": 1, "items": {"type": "number", "minimum": 0, "maximum": 1}}, "result": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "uncertainty": {"type": "array", "items": {"type": "string"}}}},
    "capability_handoff": {"type": "object", "additionalProperties": false, "required": ["product_id", "artifact_id", "preserved_finding_ids", "preserved_evidence_refs", "unresolved_conflict_ids", "escalation_ids", "intended_consumers", "handoff_state"], "properties": {"product_id": {"type": "string", "minLength": 1}, "artifact_id": {"type": "string", "format": "uuid"}, "preserved_finding_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "preserved_evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "unresolved_conflict_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "escalation_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "intended_consumers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "handoff_state": {"enum": ["ready_for_capability_fan_in", "blocked", "authorized_partial"]}}},
    "decision_authority": {"const": "human"}
  },
  "$defs": {
    "preservedAssertion": {"type": "object", "additionalProperties": false, "required": ["source_artifact_id", "source_record_id", "record_kind", "evidence_refs", "preservation_state"], "properties": {"source_artifact_id": {"type": "string", "format": "uuid"}, "source_record_id": {"type": "string", "minLength": 1}, "record_kind": {"enum": ["observation", "assessment", "finding", "pattern", "insight", "conflict", "decision_request"]}, "evidence_refs": {"type": "array", "items": {"type": "string"}}, "preservation_state": {"const": "preserved_without_rewrite"}}},
    "derivedAssertion": {"type": "object", "additionalProperties": false, "required": ["assertion_id", "statement", "contributing_artifact_ids", "contributing_record_ids", "correlation_logic", "assumptions", "alternatives", "confidence", "uncertainty"], "properties": {"assertion_id": {"type": "string", "minLength": 1}, "statement": {"type": "string", "minLength": 1}, "contributing_artifact_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "format": "uuid"}}, "contributing_record_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "correlation_logic": {"type": "string", "minLength": 1}, "assumptions": {"type": "array", "items": {"type": "string"}}, "alternatives": {"type": "array", "items": {"type": "string"}}, "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "uncertainty": {"type": "array", "items": {"type": "string"}}}}
  }
}
