{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-review-harness/schemas/agent-focus-profile.schema.json",
  "title": "Agent Focus Profile",
  "description": "Versioned, machine-readable definition of the professional or control-plane lens that must govern one registered agent's prompt, evidence selection, rubric, compression, and handoff.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "profile_id",
    "profile_version",
    "agent",
    "source",
    "focus",
    "prompt_binding",
    "handoff",
    "lifecycle"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "1.0.0"},
    "profile_id": {"type": "string", "pattern": "^FOCUS-[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"},
    "profile_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_uuid", "designation", "display_name", "layer", "contract_version"],
      "properties": {
        "agent_uuid": {"type": "string", "format": "uuid"},
        "designation": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"},
        "display_name": {"type": "string", "minLength": 1},
        "layer": {"enum": ["specialist", "product", "capability", "enterprise", "work", "orchestration"]},
        "contract_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity_registry", "identity_registry_version", "specification", "specification_sha256"],
      "properties": {
        "identity_registry": {"const": "agents/agent-identities.json"},
        "identity_registry_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "specification": {"type": "string", "pattern": "^agents/.+\\.md$"},
        "specification_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "focus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mission",
        "authoritative_questions",
        "dimensions",
        "evidence_priorities",
        "required_methods",
        "required_outputs",
        "prohibited_conclusions",
        "rubric_checks"
      ],
      "properties": {
        "mission": {"type": "string", "minLength": 20},
        "authoritative_questions": {"$ref": "#/$defs/nonempty_unique_strings"},
        "dimensions": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
        "evidence_priorities": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
        "required_methods": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 8}},
        "required_outputs": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
        "prohibited_conclusions": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 8}},
        "rubric_checks": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 8}}
      }
    },
    "prompt_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_sections", "compression_protected_elements", "missing_profile_effect", "hash_mismatch_effect"],
      "properties": {
        "required_sections": {
          "type": "array",
          "const": ["mission", "authoritative_questions", "dimensions", "evidence_priorities", "required_methods", "required_outputs", "prohibited_conclusions", "rubric_checks"]
        },
        "compression_protected_elements": {"type": "array", "minItems": 6, "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
        "missing_profile_effect": {"const": "fail_closed_before_dispatch"},
        "hash_mismatch_effect": {"const": "fail_closed_before_dispatch"}
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preserve", "consumer_rule"],
      "properties": {
        "preserve": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
        "consumer_rule": {"type": "string", "minLength": 20}
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_status", "dispatch_requirement", "change_control"],
      "properties": {
        "agent_status": {"enum": ["seed", "planned", "baseline", "candidate", "active", "deprecated", "retired"]},
        "dispatch_requirement": {"const": "exact_profile_id_version_and_sha256_required"},
        "change_control": {"const": "new_profile_version_and_regression_evidence_required"}
      }
    }
  },
  "$defs": {
    "nonempty_unique_strings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 10}
    }
  }
}
