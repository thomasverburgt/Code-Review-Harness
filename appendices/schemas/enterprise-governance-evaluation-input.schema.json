{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://code-review-harness/schemas/enterprise-governance-evaluation-input.schema.json",
  "title": "ENT-GOV Accepted-Live Evaluation Input", "type": "object", "additionalProperties": false,
  "required": ["manifest_id", "manifest_version", "generated_at", "ent_evidence_gate", "cap_synth_candidate", "cap_synth_eligibility", "governance_source_manifest", "governance_evidence_manifest", "admitted_capability_artifact_ids", "excluded_child_artifact_ids", "anti_double_counting", "evidence_tier", "effect", "manifest_hash"],
  "properties": {
    "manifest_id": {"type": "string", "format": "uuid"}, "manifest_version": {"const": "1.0.0"}, "generated_at": {"type": "string", "format": "date-time"},
    "ent_evidence_gate": {"$ref": "#/$defs/binding"}, "cap_synth_candidate": {"$ref": "#/$defs/binding"}, "cap_synth_eligibility": {"$ref": "#/$defs/binding"}, "governance_source_manifest": {"$ref": "#/$defs/binding"}, "governance_evidence_manifest": {"$ref": "#/$defs/binding"},
    "admitted_capability_artifact_ids": {"type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": {"type": "string", "format": "uuid"}},
    "excluded_child_artifact_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "format": "uuid"}},
    "anti_double_counting": {"const": "parent_only_children_retained_as_lineage"}, "evidence_tier": {"const": "accepted_live_multi_domain_single_capability_governance_evaluation"},
    "effect": {"const": "evaluation_input_only"}, "manifest_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "binding": {"type": "object", "additionalProperties": false, "required": ["id", "hash"], "properties": {"id": {"type": "string", "format": "uuid"}, "hash": {"$ref": "#/$defs/hash"}}}}
}
