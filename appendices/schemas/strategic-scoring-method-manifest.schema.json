{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://code-review-harness/schemas/strategic-scoring-method-manifest.schema.json","title":"Strategic Scoring Method Manifest","type":"object","additionalProperties":false,
  "required":["method_id","method_version","created_at","scope_id","declared_by","normalization","weights","aggregation","missingness","confidence","sensitivity","composite_allowed","threshold_context","method_hash"],
  "properties":{"method_id":{"type":"string","format":"uuid"},"method_version":{"const":"1.0.0"},"created_at":{"type":"string","format":"date-time"},"scope_id":{"type":"string"},"declared_by":{"type":"object","additionalProperties":false,"required":["authority_role","authority_name"],"properties":{"authority_role":{"const":"scoring-method-owner"},"authority_name":{"type":"string"}}},"normalization":{"const":"identity_0_1"},"weights":{"type":"object","minProperties":1,"additionalProperties":{"type":"number","minimum":0,"maximum":1}},"aggregation":{"const":"weighted_mean"},"missingness":{"const":"preserve_unknown_no_imputation"},"confidence":{"const":"preserve_source_confidence"},"sensitivity":{"type":"object","additionalProperties":false,"required":["weight_delta"],"properties":{"weight_delta":{"type":"number","minimum":0,"maximum":0.25}}},"composite_allowed":{"const":false},"threshold_context":{"type":"null"},"method_hash":{"$ref":"#/$defs/hash"}},
  "$defs":{"hash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}}
}
