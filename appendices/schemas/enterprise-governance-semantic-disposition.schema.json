{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-review-harness/schemas/enterprise-governance-semantic-disposition.schema.json",
  "title": "ENT-GOV Semantic Disposition",
  "type": "object",
  "additionalProperties": false,
  "required": ["disposition_id", "packet_id", "packet_hash", "candidate_id", "candidate_hash", "decided_at", "decided_by", "disposition", "reviewed_dimensions", "semantic_judgment", "acknowledged_boundaries", "decision_authority", "effect", "scheduling_authorized", "report_effect", "deployment_effect", "disposition_hash"],
  "properties": {
    "disposition_id": {"type": "string", "format": "uuid"},
    "packet_id": {"type": "string", "format": "uuid"},
    "packet_hash": {"$ref": "#/$defs/hash"},
    "candidate_id": {"type": "string", "format": "uuid"},
    "candidate_hash": {"$ref": "#/$defs/hash"},
    "decided_at": {"type": "string", "format": "date-time"},
    "decided_by": {"type": "object", "additionalProperties": false, "required": ["authority_role", "authority_name", "subject_id"], "properties": {"authority_role": {"const": "project-owner"}, "authority_name": {"const": "thomasverburgt"}, "subject_id": {"const": "HUMAN-PROJECT-OWNER-001"}}},
    "disposition": {"enum": ["accept_semantically_faithful", "require_correction", "reject_semantics", "insufficient_evidence"]},
    "reviewed_dimensions": {"const": ["source_authority", "obligation_preservation", "applicability", "capability_evidence", "missingness", "confidence_and_uncertainty", "authority_boundary", "rollback"]},
    "semantic_judgment": {"type": "object", "additionalProperties": false, "required": ["statement", "governance_posture", "confidence_interpretation"], "properties": {"statement": {"const": "Revised packet checks out."}, "governance_posture": {"const": "insufficient_evidence"}, "confidence_interpretation": {"const": "confidence_in_bounded_evidence_insufficiency_not_compliance"}}},
    "acknowledged_boundaries": {"type": "object", "additionalProperties": false, "required": ["single_capability_only", "no_enterprise_governance_maturity_claim", "no_compliance_determination", "no_exception_or_approval_authority", "no_policy_change", "comparison_only"], "properties": {"single_capability_only": {"const": true}, "no_enterprise_governance_maturity_claim": {"const": true}, "no_compliance_determination": {"const": true}, "no_exception_or_approval_authority": {"const": true}, "no_policy_change": {"const": true}, "comparison_only": {"const": true}}},
    "decision_authority": {"const": "project_owner"},
    "effect": {"const": "semantic_acceptance_record_only"},
    "scheduling_authorized": {"const": false},
    "report_effect": {"const": "none"},
    "deployment_effect": {"const": "none"},
    "disposition_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
