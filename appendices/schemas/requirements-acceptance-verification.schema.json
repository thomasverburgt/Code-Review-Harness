{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://code-review-harness/schemas/requirements-acceptance-verification.schema.json","title":"Independent CAP-REQ Acceptance Verification","type":"object","additionalProperties":false,
