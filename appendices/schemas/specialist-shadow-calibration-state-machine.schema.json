{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-review-harness/schemas/specialist-shadow-calibration-state-machine.schema.json",
  "title": "Specialist Human Shadow Calibration State Machine",
  "type": "object",
  "additionalProperties": false,
  "required": ["machine_id", "version", "initial_state", "terminal_states", "states", "transitions", "effects"],
  "properties": {
    "machine_id": {"const": "SPECIALIST-HUMAN-SHADOW-CALIBRATION"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "initial_state": {"type": "string"},
    "terminal_states": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "states": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string"}},
    "transitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "event", "to", "actor_type", "guard"],
        "properties": {
          "from": {"type": "string"},
          "event": {"type": "string"},
          "to": {"type": "string"},
          "actor_type": {"enum": ["system", "human_reviewer", "qualified_subject_matter_expert", "project_owner"]},
          "guard": {"type": "string", "minLength": 1}
        }
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["all_states", "scheduling_authority", "product_fan_in_authority", "report_authority", "deployment_authority", "a100_production_authority"],
      "properties": {
        "all_states": {"const": "comparison_only"},
        "scheduling_authority": {"const": "none"},
        "product_fan_in_authority": {"const": "none"},
        "report_authority": {"const": "none"},
        "deployment_authority": {"const": "none"},
        "a100_production_authority": {"const": "none"}
      }
    }
  }
}
