{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-review-harness/schemas/gate-result.schema.json",
  "title": "Fan-In Gate Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["gate_result_id", "workflow_id", "execution_id", "node_id", "artifact_id", "checks", "gate_state", "confidence_effect", "partial_input_authorization", "escalations", "evaluated_at"],
  "properties": {
    "gate_result_id": {"type": "string", "format": "uuid"},
    "workflow_id": {"type": "string"},
    "execution_id": {"type": "string", "format": "uuid"},
    "node_id": {"type": "string"},
    "artifact_id": {"type": "string"},
    "checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check"}},
    "gate_state": {"enum": ["passed", "passed_incomplete_input", "failed"]},
    "confidence_effect": {"type": "object"},
    "partial_input_authorization": {"type": ["object", "null"]},
    "escalations": {"type": "array", "items": {"type": "object"}},
    "evaluated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check", "state", "details"],
      "properties": {
        "check": {"enum": ["identity", "schema", "integrity", "lineage", "freshness", "completeness", "conflict_preservation", "capa", "authority", "routing"]},
        "state": {"enum": ["passed", "failed", "not_applicable", "authorized_exception"]},
        "details": {"type": "string"}
      }
    }
  }
}
