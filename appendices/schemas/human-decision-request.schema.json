{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-review-harness/schemas/human-decision-request.schema.json",
  "title": "Human Decision Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision_context_id", "decision_question", "decision_type", "triggering_artifacts", "available_options", "known_constraints", "uncertainties", "required_decision_authority", "decision_due_context", "evidence_refs", "decision_authority"],
  "properties": {
    "$schema": {"type": "string"},
    "decision_context_id": {"type": "string", "minLength": 1},
    "decision_question": {"type": "string", "minLength": 1},
    "decision_type": {"type": "string", "minLength": 1},
    "triggering_artifacts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "available_options": {"type": "array", "items": {"type": "object"}},
    "known_constraints": {"type": "array", "items": {"type": "string"}},
    "uncertainties": {"type": "array", "items": {"type": "string"}},
    "required_decision_authority": {"type": "string", "minLength": 1},
    "decision_due_context": {"type": ["string", "null"]},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "decision_authority": {"const": "human"}
  }
}
