{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-review-harness/schemas/evidence-locator.schema.json",
  "title": "Reproducible Evidence Locator",
  "type": "object",
  "additionalProperties": false,
  "required": ["locator_id", "evidence_id", "source_type", "repository_uri", "immutable_revision", "path", "line_start", "line_end", "symbol_or_section", "safe_excerpt", "redaction", "line_fingerprint", "collector", "collection_method", "collected_at", "access", "reproduction_steps", "locator_state", "locator_hash"],
  "properties": {
    "locator_id": {"type": "string", "minLength": 1},
    "evidence_id": {"type": "string", "minLength": 1},
    "source_type": {"enum": ["git_source", "configuration", "iac", "test_result", "runtime_telemetry", "external_record"]},
    "repository_uri": {"type": "string", "minLength": 1},
    "immutable_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "path": {"type": "string", "minLength": 1},
    "line_start": {"type": ["integer", "null"], "minimum": 1},
    "line_end": {"type": ["integer", "null"], "minimum": 1},
    "symbol_or_section": {"type": ["string", "null"]},
    "safe_excerpt": {"type": "string", "minLength": 1},
    "redaction": {
      "type": "object", "additionalProperties": false,
      "required": ["applied", "method", "raw_value_included"],
      "properties": {"applied": {"type": "boolean"}, "method": {"type": "string", "minLength": 1}, "raw_value_included": {"const": false}}
    },
    "line_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "collector": {"type": "string", "minLength": 1},
    "collection_method": {"type": "string", "minLength": 1},
    "collected_at": {"type": "string", "format": "date-time"},
    "access": {
      "type": "object", "additionalProperties": false,
      "required": ["classification", "constraints", "reviewer_instructions"],
      "properties": {"classification": {"type": "string", "minLength": 1}, "constraints": {"type": "array", "items": {"type": "string"}}, "reviewer_instructions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}
    },
    "reproduction_steps": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "locator_state": {"enum": ["source_located", "source_partially_located", "source_inaccessible", "source_no_longer_matches", "source_locator_unverified"]},
    "locator_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
