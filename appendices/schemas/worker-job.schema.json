{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-review-harness/schemas/worker-job.schema.json",
  "title": "Worker Execution Job",
  "type": "object",
  "additionalProperties": false,
  "required": ["job_id", "idempotency_key", "execution_id", "node_id", "designation", "dispatch", "evidence_paths", "allowed_evidence_paths", "max_attempts", "timeout_seconds", "created_at"],
  "properties": {
    "job_id": {"type": "string", "format": "uuid"},
    "idempotency_key": {"type": "string", "minLength": 1},
    "execution_id": {"type": "string", "format": "uuid"},
    "node_id": {"type": "string", "minLength": 1},
    "designation": {"enum": ["SPEC-SECRETS", "PROD-SEC", "CAP-RISK", "ENT-SYSRISK"]},
    "dispatch": {"type": "object"},
    "evidence_paths": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "allowed_evidence_paths": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "max_attempts": {"type": "integer", "minimum": 1, "maximum": 5},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
    "created_at": {"type": "string", "format": "date-time"},
    "generation_mode": {"enum": ["full_artifact", "role_payload_v1", "canonical_payload_v1"]},
    "generation_contract_version": {"type": "string", "minLength": 1},
    "assembler_version": {"type": "string", "minLength": 1},
    "projection_version": {"type": "string", "minLength": 1}
  }
}
