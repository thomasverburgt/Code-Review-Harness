{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-review-harness/schemas/cap-risk-role.schema.json",
  "title": "CAP-RISK Role Extension",
  "type": "object",
  "additionalProperties": false,
  "required": ["designation", "risk_register", "risk_provenance", "emergent_risk_analysis", "rio_method_version", "systemic_relationships", "recommended_coas", "capa_options", "escalation_flags", "decision_authority"],
  "properties": {
    "designation": {"const": "CAP-RISK"},
    "risk_register": {"type": "array", "items": {"$ref": "#/$defs/risk"}},
    "risk_provenance": {"type": "array", "items": {"type": "object"}},
    "emergent_risk_analysis": {"type": "array", "items": {"type": "object"}},
    "rio_method_version": {"type": "string", "minLength": 1},
    "systemic_relationships": {"type": "array", "items": {"type": "object"}},
    "recommended_coas": {"type": "array", "items": {"type": "object"}},
    "capa_options": {"type": "array", "items": {"type": "object"}},
    "escalation_flags": {"type": "array", "items": {"type": "object"}},
    "decision_authority": {"const": "human"}
  },
  "$defs": {
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["risk_id", "capability_id", "record_type", "risk_statement", "risk_category", "contributing_artifacts", "dependency_chain", "mission_effect", "likelihood_basis", "impact_basis", "probability", "consequence", "priority", "confidence", "aggregation_method", "residual_risk", "treatment_options", "escalation_state", "decision_owner"],
      "properties": {
        "risk_id": {"type": "string", "minLength": 1},
        "capability_id": {"type": "string", "minLength": 1},
        "record_type": {"enum": ["inherited", "derived", "emergent"]},
        "risk_statement": {"type": "string", "minLength": 1},
        "risk_category": {"type": "string", "minLength": 1},
        "contributing_artifacts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "dependency_chain": {"type": "array", "items": {"type": "string"}},
        "mission_effect": {"type": "string", "minLength": 1},
        "likelihood_basis": {"type": "string", "minLength": 1},
        "impact_basis": {"type": "string", "minLength": 1},
        "probability": {"type": ["number", "string", "null"]},
        "consequence": {"type": ["number", "string", "null"]},
        "priority": {"type": ["number", "string", "null"]},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "aggregation_method": {"type": "string", "minLength": 1},
        "residual_risk": {"type": ["object", "null"]},
        "treatment_options": {"type": "array", "items": {"type": "object"}},
        "escalation_state": {"type": "string", "minLength": 1},
        "decision_owner": {"type": "string", "minLength": 1}
      }
    }
  }
}
