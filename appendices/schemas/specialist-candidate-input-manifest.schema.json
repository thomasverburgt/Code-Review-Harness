{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-review-harness/schemas/specialist-candidate-input-manifest.schema.json",
  "title": "Specialist Human Shadow Calibration Input Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_id", "manifest_version", "created_at", "candidate", "repository",
    "evidence_population", "focus_binding", "execution_bindings", "environment",
    "lifecycle", "manifest_hash"
  ],
  "properties": {
    "manifest_id": {"type": "string", "format": "uuid"},
    "manifest_version": {"const": "1.0.0"},
    "created_at": {"type": "string", "format": "date-time"},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_uuid", "designation", "agent_version", "contract_version", "product_id"],
      "properties": {
        "agent_uuid": {"type": "string", "format": "uuid"},
        "designation": {"type": "string", "pattern": "^SPEC-[A-Z0-9]+(?:-[A-Z0-9]+)*$"},
        "agent_version": {"type": "string", "minLength": 1},
        "contract_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "product_id": {"type": "string", "minLength": 1}
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_uri", "immutable_revision", "read_only", "modification_prohibited"],
      "properties": {
        "repository_uri": {"type": "string", "minLength": 1},
        "immutable_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "read_only": {"const": true},
        "modification_prohibited": {"const": true}
      }
    },
    "evidence_population": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id", "source_type", "path", "content_hash", "classification",
          "admitted", "safe_for_human_review", "allowed_reviewer_tracks", "purpose"
        ],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "source_type": {"enum": ["git_source", "configuration", "iac", "test_result", "runtime_telemetry", "external_record"]},
          "path": {"type": "string", "minLength": 1},
          "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "classification": {"enum": ["public", "internal", "restricted"]},
          "admitted": {"const": true},
          "safe_for_human_review": {"type": "boolean"},
          "allowed_reviewer_tracks": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["general_engineering_intern", "restricted_domain_reviewer", "qualified_subject_matter_expert"]}
          },
          "purpose": {"type": "string", "minLength": 1}
        }
      }
    },
    "focus_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "profile_version", "profile_hash", "source_specification", "source_specification_hash", "compiled_prompt_focus_hash", "compression_protected_elements"],
      "properties": {
        "profile_id": {"type": "string", "pattern": "^FOCUS-SPEC-[A-Z0-9]+(?:-[A-Z0-9]+)*$"},
        "profile_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "profile_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "source_specification": {"type": "string", "minLength": 1},
        "source_specification_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "compiled_prompt_focus_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "compression_protected_elements": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "execution_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt", "role_schema", "rubric", "model_manifest", "tool_policy"],
      "properties": {
        "prompt": {"$ref": "#/$defs/versionedBinding"},
        "role_schema": {"$ref": "#/$defs/versionedBinding"},
        "rubric": {"$ref": "#/$defs/versionedBinding"},
        "model_manifest": {"$ref": "#/$defs/versionedBinding"},
        "tool_policy": {"$ref": "#/$defs/versionedBinding"}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution_mode", "platform_class", "environment_policy_version"],
      "properties": {
        "execution_mode": {"const": "specialist_human_shadow_calibration"},
        "platform_class": {"const": "dgx_spark_or_equivalent"},
        "environment_policy_version": {"type": "string", "minLength": 1}
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comparison_only", "scheduled", "product_fan_in_eligible", "deployment_authorized",
        "a100_production_authorized", "retention_class"
      ],
      "properties": {
        "comparison_only": {"const": true},
        "scheduled": {"const": false},
        "product_fan_in_eligible": {"const": false},
        "deployment_authorized": {"const": false},
        "a100_production_authorized": {"const": false},
        "retention_class": {"const": "specialist-human-shadow-calibration"}
      }
    },
    "manifest_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "$defs": {
    "versionedBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "hash"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  }
}
