{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-review-harness/schemas/sandbox-evolution-loop.schema.json",
  "title": "Sandbox Evolution Loop Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "experiment_id",
    "loop_number",
    "baseline_revision",
    "candidate_revision",
    "changed_artifacts",
    "diff_refs",
    "change_rationale",
    "hypothesis",
    "evaluation_dataset",
    "scoring_model",
    "prior_scores",
    "candidate_scores",
    "score_delta",
    "regressions",
    "confidence",
    "policy_checks",
    "stop_condition",
    "operator_authorization",
    "human_disposition"
  ],
  "properties": {
    "experiment_id": {"type": "string", "minLength": 1},
    "loop_number": {"type": "integer", "minimum": 1},
    "baseline_revision": {"type": "string", "minLength": 1},
    "candidate_revision": {"type": "string", "minLength": 1},
    "changed_artifacts": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "diff_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "change_rationale": {"type": "string", "minLength": 1},
    "hypothesis": {"type": "string", "minLength": 1},
    "evaluation_dataset": {"type": "string", "minLength": 1},
    "scoring_model": {"type": "string", "minLength": 1},
    "prior_scores": {"type": "object", "additionalProperties": {"type": "number"}},
    "candidate_scores": {"type": "object", "additionalProperties": {"type": "number"}},
    "score_delta": {"type": "object", "additionalProperties": {"type": "number"}},
    "regressions": {"type": "array", "items": {"type": "string"}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "policy_checks": {"type": "array", "items": {"type": "string"}},
    "stop_condition": {"type": "string", "minLength": 1},
    "operator_authorization": {"type": "string", "minLength": 1},
    "human_disposition": {"enum": ["pending", "rejected", "revise", "approved_for_promotion"]},
    "promotion_reference": {"type": ["string", "null"]}
  }
}