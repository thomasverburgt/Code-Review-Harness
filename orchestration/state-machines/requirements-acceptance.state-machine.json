{
  "$schema": "../../appendices/schemas/requirements-acceptance-state-machine.schema.json",
  "machine_id": "requirements-acceptance",
  "version": "2.0.0",
  "initial_state": "candidate_validated",
  "states": ["candidate_validated", "packet_materialized", "external_review_pending", "response_recorded", "owner_finalized", "eligible_for_accepted_capability_input", "not_eligible", "revoked"],
  "terminal_states": ["eligible_for_accepted_capability_input", "not_eligible", "revoked"],
  "transitions": [
    {"from": "candidate_validated", "event": "packet_generated", "to": "packet_materialized", "authority": "system"},
    {"from": "packet_materialized", "event": "delivered_for_review", "to": "external_review_pending", "authority": "system"},
    {"from": "external_review_pending", "event": "response_recorded", "to": "response_recorded", "authority": "requirements-acceptance-authority"},
    {"from": "response_recorded", "event": "owner_finalized", "to": "owner_finalized", "authority": "project-owner"},
    {"from": "response_recorded", "event": "owner_rejected", "to": "not_eligible", "authority": "project-owner"},
    {"from": "owner_finalized", "event": "accepted_review_derived", "to": "eligible_for_accepted_capability_input", "authority": "system"},
    {"from": "owner_finalized", "event": "nonacceptance_derived", "to": "not_eligible", "authority": "system"},
    {"from": "eligible_for_accepted_capability_input", "event": "eligibility_revoked", "to": "revoked", "authority": "project-owner"}
  ],
  "effects": {"acceptance": "eligibility_only_after_project_owner_finalization", "satisfaction": "none", "readiness": "none", "risk": "none", "scheduling": "none", "report_distribution": "none", "deployment": "none"}
}
